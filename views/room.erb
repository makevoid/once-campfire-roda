<section class="chat" data-room-id="<%= room.id %>" data-cursor="<%= cursor %>">
  <header class="room-header"><div><small><%= room.direct? ? 'DIRECT MESSAGE' : room.open? ? 'OPEN ROOM' : 'PRIVATE ROOM' %></small><h1><%= view.h(name) %></h1></div><a href="/rooms/<%= room.id %>/settings">Room settings</a></header>
  <div id="messages" class="messages" aria-live="polite">
    <% unless page.empty? %><button type="button" id="load-older" data-before="<%= page.messages.first[:id] %>">Load earlier messages</button><% end %>
    <%= view.messages(page, user: user) %>
    <% if page.empty? %><p class="empty">This is the beginning of the conversation.</p><% end %>
  </div>
  <form id="composer" action="/rooms/<%= room.id %>/messages" method="post" enctype="multipart/form-data">
    <input type="hidden" name="authenticity_token" value="<%= view.h(csrf) %>">
    <label class="sr-only" for="message-body">Message</label>
    <textarea id="message-body" name="message[body]" placeholder="Write a message…" rows="2" maxlength="100000"></textarea>
    <div><label class="file-label">Attach a file <input type="file" name="message[attachment]"></label><span class="hint">Enter to send · Shift+Enter for a new line</span><button class="primary">Send</button></div>
  </form>
</section>
