<section class="panel">
  <h1><%= view.h(title) %></h1>
  <form action="<%= view.h(action) %>" method="post" enctype="multipart/form-data">
    <input type="hidden" name="authenticity_token" value="<%= view.h(csrf) %>">
    <% unless method == "post" %><input type="hidden" name="_method" value="<%= view.h(method) %>"><% end %>
    <% fields.each do |field| %>
      <label><%= view.h(field.fetch(:label)) %>
        <% if field[:type] == "textarea" %>
          <textarea name="<%= view.h(field[:name]) %>" rows="5"><%= view.h(field[:value]) %></textarea>
        <% else %>
          <input type="<%= view.h(field.fetch(:type, 'text')) %>" name="<%= view.h(field[:name]) %>" value="<%= view.h(field[:value]) %>" <%= field[:required] ? 'required' : '' %> <%= field[:type] == "password" ? 'minlength="12" maxlength="72"' : '' %>>
        <% end %>
      </label>
    <% end %>
    <%= extras %>
    <button class="primary"><%= view.h(submit) %></button>
  </form>
</section>
