<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="<%= view.h(csrf) %>">
  <meta name="theme-color" content="#242d35">
  <title><%= view.h(title) %> · Campfire</title>
  <link rel="stylesheet" href="/app.css">
  <link rel="manifest" href="/webmanifest">
  <script src="/app.js" defer></script>
</head>
<body class="<%= user ? 'signed-in' : 'signed-out' %>">
  <% if user %>
    <aside id="sidebar"><%= sidebar %><footer><a href="/users/me/profile"><%= view.h(user[:name]) %></a><% if user.administrator? %><a href="/account/edit">Settings</a><% end %><form action="/session" method="post"><input type="hidden" name="authenticity_token" value="<%= view.h(csrf) %>"><input type="hidden" name="_method" value="delete"><button>Sign out</button></form></footer></aside>
  <% end %>
  <main id="main"><%= content %></main>
  <div id="notice" role="status" hidden></div>
</body>
</html>
