<% booster = boost.booster %>
<div id="boost_<%= boost.id %>" class="boost boost-item flex-inline postion--relative max-width align-center fill-white gap"
    data-controller="boost-delete" data-boost-delete-perform-class="boost--deleting" data-boost-delete-reveal-class="expanded" data-boost-delete-booster-id-value="<%= booster.id %>">
  <figure class="avatar boost__avatar flex-item-no-shrink">
    <a href="/users/<%= booster.id %>" title="<%= booster.title %>" class="btn avatar" data-turbo-frame="_top"><img src="<%= avatar_url(booster) %>" width="48" height="48" aria-label="<%= "#{booster.name} boosted #{boost.content}" %>"></a>
  </figure>
  <span role="button" class="txt-small <%= 'txt-medium' if emoji_only?(boost.content) %>" data-action="click->boost-delete#reveal keydown.enter->boost-delete#reveal:prevent" data-boost-delete-target="content"><%= boost.content %></span>
  <form action="/messages/<%= boost[:message_id] %>/boosts/<%= boost.id %>" method="post">
    <input type="hidden" name="_method" value="delete">
    <button type="submit" data-action="boost-delete#perform" data-boost-delete-target="button" class="btn btn--negative flex-item-justify-end boost__delete">
      <img src="<%= asset_path('minus.svg') %>" width="20" height="20" aria-hidden="true">
      <span class="for-screen-reader">Delete this boost</span>
    </button>
  </form>
</div>
<span id="delete_boost_accessible_label" class="for-screen-reader">Press enter to delete this boost</span>
