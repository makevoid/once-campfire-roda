<% timestamp = epoch(message.created_at); key = message[:client_message_id]; creator = message.creator %>
<div id="message_<%= key %>" class="message <%= 'message--emoji' if emoji_only?(message.plain_text_body) %>"
    data-controller="reply" data-user-id="<%= creator.id %>" data-message-id="<%= message.id %>"
    data-message-timestamp="<%= timestamp %>" data-message-updated-at="<%= epoch(message.updated_at) %>" data-sort-value="<%= timestamp %>"
    data-messages-target="message" data-search-results-target="message" data-refresh-room-target="message" data-reply-composer-outlet="#composer">
  <h2 class="message__day-separator"><time datetime="<%= message.created_at.iso8601 %>" data-local-time-target="date"></time></h2>
  <figure class="avatar message__avatar">
    <a href="/users/<%= creator.id %>" title="<%= creator.title %>" class="btn avatar" data-turbo-frame="_top"><img src="<%= avatar_url(creator) %>" aria-hidden="true" width="48" height="48"></a>
  </figure>
  <turbo-frame id="edit_message_<%= key %>">
    <div class="message__body">
      <div class="message__body-content">
        <div class="message__meta">
          <h3 class="message__heading">
            <span class="message__author" title="<%= creator.title %>"><strong data-reply-target="author"><%= creator.name %></strong></span>
            <a href="/rooms/<%= message.room.id %>/@<%= message.id %>" target="_top" class="message__permalink"><time class="message__timestamp" datetime="<%= message.created_at.iso8601 %>" data-local-time-target="time"></time></a>
            <span class="message__room"><a href="/rooms/<%= message.room.id %>/@<%= message.id %>" target="_top" data-reply-target="link"><%= room_display_name(message.room, for_user: nil) %></a></span>
          </h3>
          <%= render "messages/actions", message: message, url: "#{request.base_url}/rooms/#{message.room.id}/@#{message.id}" %>
        </div>
        <%= render "messages/presentation", message: message %>
        <%= render "messages/boosts/boosts", message: message %>
      </div>
    </div>
  </turbo-frame>
</div>
